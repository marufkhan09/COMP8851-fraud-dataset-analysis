  "environment": "1x RTX A6000 48 GiB as in Ass2; isolated Python/DGL environments",
  "canonical_rules": [
    "Verify source/split SHA256 first",
    "Keep validation/test fixed across ratios",
    "Hyperparameter selection on validation only",
    "Never tune using test",
    "Adapters may alter input format but not model loss/architecture/mechanism",
    "Store raw per-seed scores and timestamps",
    "Record setup, training, validation/inference, peak GPU memory separately"
  ],
  "approval_pending": [
    "Any SAWGAD weak-supervision and 450-epoch schedule reconciliation",
    "RGTAN five-fold native vs canonical fixed split",
    "EOGFD author import mismatch and test evaluation within train loop",
    "Large-graph infeasibility and time cap policies",
    "Any fanout/population/budget changes"
